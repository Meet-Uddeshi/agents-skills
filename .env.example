# Meet AI Agents - Environment Variables & MCP Secrets Template
# Copy this file to .env and provide your credentials. Never commit real keys to git.

# -----------------------------------------------------------------------------
# 1. GitHub Integration (MCP Server: @modelcontextprotocol/server-github)
# Required for: devops-engineer, code-reviewer, release-engineer
# Scopes: repo, workflow, read:org
# -----------------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# -----------------------------------------------------------------------------
# 2. Atlassian Jira Integration (MCP Server: @atlassian/mcp-server-jira)
# Required for: project-planner, product-manager, product-owner
# -----------------------------------------------------------------------------
JIRA_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_EMAIL=your_email@domain.com

# -----------------------------------------------------------------------------
# 3. Linear Integration (MCP Server: @linear/mcp-server)
# Required for: project-planner, product-owner
# -----------------------------------------------------------------------------
LINEAR_API_KEY=lin_api_your_key_here

# -----------------------------------------------------------------------------
# 4. Slack Automation (MCP Server: @modelcontextprotocol/server-slack)
# Required for: coordinator, chief-of-staff, release-engineer
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_TEAM_ID=T0123456789

# -----------------------------------------------------------------------------
# 5. Database Integration (MCP Server: @modelcontextprotocol/server-postgres)
# Required for: database-architect, database-reviewer
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# -----------------------------------------------------------------------------
# 6. Web Search & Documentation (MCP Server: @modelcontextprotocol/server-brave-search)
# Required for: reverse-engineering-anything, explore, code-archaeologist
# -----------------------------------------------------------------------------
BRAVE_API_KEY=your_brave_api_key_here

# -----------------------------------------------------------------------------
# 7. Context Caching & Vector Search (MCP Server: @upstash/context7-mcp)
# -----------------------------------------------------------------------------
CONTEXT7_API_KEY=your_context7_api_key_here

